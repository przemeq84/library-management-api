# Copy to .env and adjust. Every variable is optional.

# Application time zone (IANA name). Also sets the OS time zone inside containers,
# so recurring job schedules (e.g. "every day at 8am") use the same zone as the app.
# This should be set to library timezone
TZ=Europe/Warsaw

# PostgreSQL connection. Leave unset locally to use the domain socket and your OS user.
DB_HOST=localhost
DB_PORT=54320 # docker instance
DB_USER=postgres
DB_PASSWORD=postgres
# GSSAPI (Kerberos) encryption: disable (default), prefer or require. Only change it for a Kerberos-enabled server.
DB_GSSENCMODE=disable

# Required in production. Generate one with `bin/rails secret`.
SECRET_KEY_BASE=

# Sender address of reminder emails.
MAILER_FROM=library@example.com

# Log verbosity in production (debug, info, warn, error).
RAILS_LOG_LEVEL=info
